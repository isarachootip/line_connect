// โครงสร้างฐานข้อมูลหลักของระบบ Line Connect (ไทวัสดุ และ BnB Home) ครบ 11 ตารางตามสเปก
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Brand {
  TWD
  BNB
}

enum LineLinkStatus {
  active
  unlinked
}

enum ConsentType {
  TNC
  PDPA
  MARKETING
}

enum CouponSource {
  TWD
  THE1
}

enum CouponWalletStatus {
  available
  used
  expired
}

// 1. ตารางผูกบัญชี LINE UID กับรหัสสมาชิก The 1 แยกตามแบรนด์ (unique: line_uid + brand)
model LineLink {
  id       String         @id @default(uuid())
  lineUid  String         @map("line_uid")
  memberId String         @map("member_id")
  brand    Brand
  linkedAt DateTime       @default(now()) @map("linked_at")
  status   LineLinkStatus @default(active)

  @@unique([lineUid, brand])
  @@index([memberId])
  @@index([status])
  @@map("line_link")
}

// 2. ตารางประวัติความยินยอม (Append-only: ห้าม update ทับ ให้ insert แถวใหม่ทุกครั้ง)
model Consent {
  id        String      @id @default(uuid())
  memberId  String      @map("member_id")
  type      ConsentType
  version   String
  grantedAt DateTime?   @map("granted_at")
  revokedAt DateTime?   @map("revoked_at")

  @@index([memberId, type, version])
  @@index([memberId, grantedAt])
  @@map("consent")
}

// 3. ตารางเก็บ Token ของ The 1 (access_token และ refresh_token เข้ารหัสระดับ column ด้วย key จาก env)
model The1Token {
  memberId     String   @id @map("member_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("the1_token")
}

// 4. ตารางแคชข้อมูลโปรไฟล์สมาชิกจาก The 1 (first_name และ last_name เข้ารหัสตอนจัดเก็บ)
model MemberProfile {
  memberId    String   @id @map("member_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  tier        String
  points      Int
  refreshedAt DateTime @default(now()) @map("refreshed_at")

  @@index([tier])
  @@index([refreshedAt])
  @@map("member_profile")
}

// 5. ตารางธุรกรรมยอดใช้จ่ายรายลูกค้าจากไทวัสดุ
model SpendingTxn {
  txnId    String   @id @unique @map("txn_id")
  memberId String   @map("member_id")
  store    String
  amount   Decimal  @db.Decimal(12, 2)
  category String
  sku      String
  txnAt    DateTime @map("txn_at")

  @@index([memberId, txnAt])
  @@index([store])
  @@index([category])
  @@map("spending_txn")
}

// 6. ตารางแคมเปญภารกิจสะสมยอดซื้อ (Mission)
model Mission {
  missionId  String            @id @default(uuid()) @map("mission_id")
  name       String
  rule       Json              @db.JsonB
  target     Decimal           @db.Decimal(12, 2)
  startAt    DateTime          @map("start_at")
  endAt      DateTime          @map("end_at")
  reward     Json              @db.JsonB
  status     String
  progresses MissionProgress[]

  @@index([status, startAt, endAt])
  @@map("mission")
}

// 7. ตารางความคืบหน้าภารกิจของสมาชิกรายคน (unique: member_id + mission_id)
model MissionProgress {
  id          String    @id @default(uuid())
  memberId    String    @map("member_id")
  missionId   String    @map("mission_id")
  progress    Decimal   @db.Decimal(12, 2)
  completedAt DateTime? @map("completed_at")
  mission     Mission   @relation(fields: [missionId], references: [missionId], onDelete: Restrict)

  @@unique([memberId, missionId])
  @@index([missionId])
  @@index([memberId])
  @@map("mission_progress")
}

// 8. ตารางข้อมูลคูปองส่วนลดและสิทธิพิเศษ (จากไทวัสดุ หรือ The 1)
model Coupon {
  couponId    String         @id @default(uuid()) @map("coupon_id")
  code        String         @unique
  source      CouponSource
  type        String
  value       Decimal        @db.Decimal(12, 2)
  maxDiscount Decimal?       @map("max_discount") @db.Decimal(12, 2)
  validFrom   DateTime       @map("valid_from")
  validTo     DateTime       @map("valid_to")
  wallets     CouponWallet[]

  @@index([source, validFrom, validTo])
  @@map("coupon")
}

// 9. ตารางกระเป๋าคูปองของสมาชิกแต่ละราย
model CouponWallet {
  id       String             @id @default(uuid())
  memberId String             @map("member_id")
  couponId String             @map("coupon_id")
  status   CouponWalletStatus @default(available)
  usedAt   DateTime?          @map("used_at")
  coupon   Coupon             @relation(fields: [couponId], references: [couponId], onDelete: Restrict)

  @@index([memberId, status])
  @@index([couponId])
  @@map("coupon_wallet")
}

// 10. ตารางบันทึกการส่งไฟล์ Batch กลุ่มเป้าหมายกลับไทวัสดุ
model TargetBatch {
  batchId  String    @id @default(uuid()) @map("batch_id")
  segment  String
  filePath String    @map("file_path")
  rowCount Int       @map("row_count")
  sentAt   DateTime? @map("sent_at")

  @@index([segment, sentAt])
  @@map("target_batch")
}

// 11. ตารางบันทึกประวัติการใช้งานและเหตุการณ์สำคัญ (Audit Log)
model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  target    String
  metadata  Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actor, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}
