# ==============================================================================
# 1. การตั้งค่าสภาพแวดล้อมของระบบ (Environment Profile: dev | staging | prod)
# ==============================================================================
# สภาพแวดล้อมของแอปพลิเคชันสำหรับแยก Config: dev | staging | prod
APP_ENV=dev

# สภาพแวดล้อมของ Node.js runtime: development | staging | production | test
NODE_ENV=development

# พอร์ตสำหรับรัน Backend API (apps/api)
PORT=3000

# ==============================================================================
# 2. การตั้งค่าฐานข้อมูล PostgreSQL และ Redis (Database & Cache)
# ==============================================================================
# ชื่อผู้ใช้ รหัสผ่าน และชื่อฐานข้อมูลสำหรับ Docker Compose Local
POSTGRES_USER=lineconnect
POSTGRES_PASSWORD=lineconnect_dev_pwd
POSTGRES_DB=line_connect_db

# Connection String สำหรับเชื่อมต่อ PostgreSQL ผ่าน Prisma ORM
DATABASE_URL=postgresql://lineconnect:lineconnect_dev_pwd@localhost:5432/line_connect_db?schema=public

# โฮสต์ พอร์ต และรหัสผ่านของ Redis (สำหรับเก็บสถานะ OTP, Token Cache และ Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# อายุแคชข้อมูลโปรไฟล์สมาชิก (member_profile) ใน Redis (หน่วยเป็นวินาที, ค่าเริ่มต้น 600 = 10 นาที)
MEMBER_PROFILE_CACHE_TTL_SECONDS=600

# ==============================================================================
# 3. ความปลอดภัยและการเข้ารหัสข้อมูลส่วนบุคคล (PDPA & Token Encryption)
# ==============================================================================
# กุญแจเข้ารหัสข้อมูลส่วนบุคคลและ Token ด้วย AES-256-GCM (เลขฐานสิบหก 64 ตัวอักษร = 32 ไบต์)
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# กุญแจลับสำหรับสร้าง HMAC-SHA256 Blind Index เพื่อค้นหาเบอร์โทร/อีเมล/The 1 Member ID โดยไม่ถอดรหัสทั้งตาราง
PII_BLIND_INDEX_SECRET=replace_with_strong_hmac_secret_at_least_32_chars_long

# กุญแจลับสำหรับเซ็น JWT Session ภายในระบบ Line Connect BFF (อย่างน้อย 32 ตัวอักษร)
JWT_SECRET=replace_with_strong_jwt_secret_at_least_32_chars_long

# อายุของ Session JWT Access Token ระยะสั้น (หน่วยเป็นวินาที, ค่าเริ่มต้น 900 = 15 นาที)
JWT_ACCESS_EXPIRES_SECONDS=900

# อายุของ Refresh Token สำหรับต่ออายุ Session (หน่วยเป็นวินาที, ค่าเริ่มต้น 604800 = 7 วัน)
JWT_REFRESH_EXPIRES_SECONDS=604800

# การจำกัดอัตราการเรียกใช้งาน (Rate Limit) สำหรับ Endpoint /auth/* ต่อ IP และต่อ line_uid
AUTH_RATE_LIMIT_PER_IP=20
AUTH_RATE_LIMIT_PER_LINE_UID=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ==============================================================================
# 4. การตั้งค่า LINE Official Account & LIFF SDK (apps/api & apps/liff)
# ==============================================================================
# รหัส LINE Channel ID หลักสำหรับตรวจสอบ LINE ID Token กับ LINE Verify Endpoint
LINE_CHANNEL_ID=your_line_channel_id

# LIFF Channel ID สำหรับตรวจสอบ ID Token ฝั่ง Backend แยกตามแบรนด์ไทวัสดุ (TWD) และ BnB Home (BNB)
LINE_LIFF_CHANNEL_ID_TWD=your_twd_liff_channel_id
LINE_LIFF_CHANNEL_ID_BNB=your_bnb_liff_channel_id

# เปิดโหมดจำลองการตรวจสอบ LINE ID Token สำหรับสภาพแวดล้อม Dev และ Test (true | false)
LINE_VERIFY_MOCK=true

# URL ของ LINE OAuth2 Verify Endpoint สำหรับตรวจสอบความถูกต้องของ ID Token
LINE_VERIFY_URL=https://api.line.me/oauth2/v2.1/verify

# URL สำหรับส่งลูกค้าที่ยังไม่ผูกบัญชีไปยืนยันตัวตนด้วย OTP บนหน้าเว็บ The 1 Passport
THE1_PASSPORT_URL=https://passport-mock.the1.co.th/authorize

# รหัส LIFF ID สำหรับใช้เรียก liff.init() ในฝั่ง Frontend (apps/liff)
VITE_LIFF_ID=1234567890-AbCdEfGh

# URL ของ Backend API สำหรับให้ฝั่ง LIFF Frontend เรียกใช้งาน
VITE_API_BASE_URL=http://localhost:3000

# ==============================================================================
# 5. การเชื่อมต่อ API ภายนอกของ The 1 Passport (integration/the1)
# ==============================================================================
# เปิดโหมด Mock Server สำหรับ The 1 API คืนสมาชิกตัวอย่าง 3 คนและจำลอง Token หมดอายุ (true | false)
THE1_MOCK=true

# URL หลักของระบบ The 1 API (รอใส่ค่าจริงเมื่อยืนยัน Spec)
THE1_BASE_URL=https://api-mock.the1.co.th

# ข้อมูล Client ID และ Client Secret สำหรับเชื่อมต่อระบบ The 1
THE1_CLIENT_ID=your_the1_client_id
THE1_CLIENT_SECRET=your_the1_client_secret

# เวลา Timeout สูงสุดต่อการเรียก The 1 API 1 ครั้ง (หน่วยเป็นมิลลิวินาที, ค่าเริ่มต้น 5000)
THE1_TIMEOUT_MS=5000

# ==============================================================================
# 6. การเชื่อมต่อ API ยอดใช้จ่ายไทวัสดุ และการส่งออก Batch File (Spending & Batch)
# ==============================================================================
# ช่องทางการรับข้อมูลยอดใช้จ่ายจากไทวัสดุ: PUSH | PULL | BOTH (ค่าเริ่มต้น BOTH)
TWD_SPENDING_MODE=BOTH

# รูปแบบการยืนยันตัวตนสำหรับช่องทาง Push Webhook: HMAC | MTLS (ค่าเริ่มต้น HMAC)
TWD_SPENDING_AUTH_MODE=HMAC

# กุญแจลับสำหรับตรวจสอบลายเซ็น HMAC-SHA256 ของข้อมูล Push ยอดใช้จ่ายจากไทวัสดุ (อย่างน้อย 32 ตัวอักษร)
TWD_SPENDING_HMAC_SECRET=replace_with_strong_twd_spending_hmac_secret_32chars

# รายการ IP Address ของระบบไทวัสดุที่อนุญาตให้เรียก POST /integrations/spending (คั่นด้วยจุลภาค หรือ * สำหรับ Dev)
TWD_SPENDING_ALLOWED_IPS=127.0.0.1,::1,10.0.0.1

# รอบเวลาสำหรับรัน Job ดึงยอดใช้จ่าย (Pull Mode) จากไทวัสดุด้วย Cursor ล่าสุด (หน่วยเป็นนาที, ค่าเริ่มต้น 15)
TWD_SPENDING_PULL_INTERVAL_MINUTES=15

# เปิดโหมดจำลอง (Mock) สำหรับ API ดึงยอดใช้จ่ายรายลูกค้าของไทวัสดุ (true | false)
TWD_SPENDING_API_USE_MOCK=true

# URL หลักของ API ยอดใช้จ่ายไทวัสดุ (Get Spending)
TWD_SPENDING_API_BASE_URL=https://api-mock.thaiwatsadu.com

# API Key สำหรับเรียกข้อมูลยอดใช้จ่ายจากระบบไทวัสดุ
TWD_SPENDING_API_KEY=your_twd_spending_api_key

# โฟลเดอร์ปลายทางสำหรับส่งออกไฟล์ Batch กลุ่มเป้าหมายกลับไปยังไทวัสดุ
TWD_BATCH_EXPORT_DIR=./exports/batch

# จำนวนครั้งสูงสุดในการลองใหม่ (Retry) ของคิวเติมแต้ม The 1 (BullMQ บน Redis) ก่อนแจ้งเตือนเมื่อพลาดเกิน 3 ครั้ง
EARN_POINT_QUEUE_MAX_RETRIES=3

# เปิดโหมดจำลอง (Mock) สำหรับการส่งไฟล์ Batch ผ่าน SFTP ไปยังไทวัสดุ (true | false)
SFTP_USE_MOCK=true

# โฮสต์และพอร์ตของเซิร์ฟเวอร์ SFTP ปลายทางของไทวัสดุสำหรับรับไฟล์ Batch กลุ่มเป้าหมาย
SFTP_HOST=sftp-mock.thaiwatsadu.com
SFTP_PORT=22

# ชื่อผู้ใช้งานและพาธของไฟล์ Private Key สำหรับยืนยันตัวตนกับเซิร์ฟเวอร์ SFTP
SFTP_USER=twd_batch_user
SFTP_KEY_PATH=./secrets/id_ed25519_twd_sftp

# โฟลเดอร์ปลายทางบนเซิร์ฟเวอร์ SFTP สำหรับวางไฟล์ Batch ที่เข้ารหัสแล้ว
SFTP_REMOTE_DIR=/incoming/target-batches

# ==============================================================================
# 7. การตั้งค่าระบบ Admin Backoffice & Enterprise SSO (เช่น Azure AD / Entra ID)
# ==============================================================================
# เปิดโหมดจำลอง (Mock) สำหรับการเข้าสู่ระบบ SSO ของผู้ดูแลระบบในโหมด Dev/Test (true | false)
ADMIN_SSO_USE_MOCK=true

# URL ของผู้ให้บริการ Enterprise SSO (เช่น Azure AD OIDC Issuer URL)
ADMIN_SSO_ISSUER_URL=https://login.microsoftonline.com/common/v2.0

# รหัส Client ID ของแอปพลิเคชัน Admin Backoffice บนระบบ SSO ขององค์กร
ADMIN_SSO_CLIENT_ID=your_azure_ad_admin_client_id


