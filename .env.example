# ==============================================================================
# การตั้งค่าพื้นฐานของแอปพลิเคชัน (Application Configuration)
# ==============================================================================
# สภาพแวดล้อมการรันระบบ: development | test | production
NODE_ENV=development

# พอร์ตสำหรับรัน Backend API (NestJS BFF)
PORT=3000

# ==============================================================================
# ฐานข้อมูลและแคช (PostgreSQL & Redis Configuration)
# ==============================================================================
# URL สำหรับเชื่อมต่อฐานข้อมูล PostgreSQL (ใช้โดย Prisma ORM)
DATABASE_URL=postgresql://lineconnect:lineconnect_dev_pwd@localhost:5432/line_connect_db?schema=public

# โฮสต์และพอร์ตของ Redis (สำหรับเก็บสถานะ OTP, Cache และ Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# ความปลอดภัยและการเข้ารหัสข้อมูลส่วนบุคคล (PDPA & Token Security)
# ==============================================================================
# กุญแจสำหรับการเข้ารหัสข้อมูลส่วนบุคคลและ Token ด้วย AES-256-GCM (ต้องมีความยาว 64 ตัวอักษรฐานสิบหก = 32 ไบต์)
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# กุญแจลับสำหรับสร้าง HMAC-SHA256 Blind Index เพื่อค้นหาเบอร์โทร/อีเมล/The 1 Member ID โดยไม่ต้องถอดรหัสทั้งตาราง
PII_BLIND_INDEX_SECRET=replace_with_strong_hmac_secret_at_least_32_chars_long

# กุญแจลับสำหรับเซ็น JWT Session ภายในระบบ Line Connect BFF
JWT_SECRET=replace_with_strong_jwt_secret_at_least_32_chars_long

# ==============================================================================
# การเชื่อมต่อ LINE Official Account & LIFF (ไทวัสดุ และ BnB Home)
# ==============================================================================
# LIFF Channel ID สำหรับตรวจสอบ ID Token จากฝั่งไทวัสดุ (TWD) และ BnB Home
LINE_LIFF_CHANNEL_ID_TWD=your_twd_liff_channel_id
LINE_LIFF_CHANNEL_ID_BNB=your_bnb_liff_channel_id

# ==============================================================================
# การเชื่อมต่อ API ภายนอกของ The 1 Passport (External The 1 API)
# ==============================================================================
# เปิดโหมดจำลอง (Mock) สำหรับ The 1 API ในระหว่างที่ยังไม่ได้รับ Spec Endpoint จริงครบถ้วน (true | false)
THE1_API_USE_MOCK=true

# URL หลักของระบบ The 1 API (รอใส่ค่าจริงเมื่อยืนยัน Spec)
THE1_API_BASE_URL=https://api-mock.the1.co.th

# ข้อมูล Client Credentials สำหรับขอ Token จากระบบ The 1
THE1_CLIENT_ID=your_the1_client_id
THE1_CLIENT_SECRET=your_the1_client_secret

# ==============================================================================
# การเชื่อมต่อ API ยอดใช้จ่ายไทวัสดุ (Thai Watsadu Spending API & Batch)
# ==============================================================================
# เปิดโหมดจำลอง (Mock) สำหรับ API ดึงยอดใช้จ่ายไทวัสดุ (true | false)
TWD_SPENDING_API_USE_MOCK=true

# URL หลักของ API ยอดใช้จ่ายไทวัสดุ (Get Spending)
TWD_SPENDING_API_BASE_URL=https://api-mock.thaiwatsadu.com

# API Key สำหรับเรียกข้อมูลยอดใช้จ่ายจากระบบไทวัสดุ
TWD_SPENDING_API_KEY=your_twd_spending_api_key

# โฟลเดอร์ปลายทางสำหรับส่งออกไฟล์ Batch กลุ่มเป้าหมายกลับไปยังไทวัสดุ
TWD_BATCH_EXPORT_DIR=./exports/batch
