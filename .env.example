# ==============================================================================
# 1. การตั้งค่าสภาพแวดล้อมของระบบ (Environment Profile: dev | staging | prod)
# ==============================================================================
# สภาพแวดล้อมของแอปพลิเคชันสำหรับแยก Config: dev | staging | prod
APP_ENV=dev

# สภาพแวดล้อมของ Node.js runtime: development | staging | production | test
NODE_ENV=development

# พอร์ตสำหรับรัน Backend API (apps/api)
PORT=3000

# ==============================================================================
# 2. การตั้งค่าฐานข้อมูล PostgreSQL และ Redis (Database & Cache)
# ==============================================================================
# ชื่อผู้ใช้ รหัสผ่าน และชื่อฐานข้อมูลสำหรับ Docker Compose Local
POSTGRES_USER=lineconnect
POSTGRES_PASSWORD=lineconnect_dev_pwd
POSTGRES_DB=line_connect_db

# Connection String สำหรับเชื่อมต่อ PostgreSQL ผ่าน Prisma ORM
DATABASE_URL=postgresql://lineconnect:lineconnect_dev_pwd@localhost:5432/line_connect_db?schema=public

# โฮสต์ พอร์ต และรหัสผ่านของ Redis (สำหรับเก็บสถานะ OTP, Token Cache และ Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# 3. ความปลอดภัยและการเข้ารหัสข้อมูลส่วนบุคคล (PDPA & Token Encryption)
# ==============================================================================
# กุญแจเข้ารหัสข้อมูลส่วนบุคคลและ Token ด้วย AES-256-GCM (เลขฐานสิบหก 64 ตัวอักษร = 32 ไบต์)
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# กุญแจลับสำหรับสร้าง HMAC-SHA256 Blind Index เพื่อค้นหาเบอร์โทร/อีเมล/The 1 Member ID โดยไม่ถอดรหัสทั้งตาราง
PII_BLIND_INDEX_SECRET=replace_with_strong_hmac_secret_at_least_32_chars_long

# กุญแจลับสำหรับเซ็น JWT Session ภายในระบบ Line Connect BFF (อย่างน้อย 32 ตัวอักษร)
JWT_SECRET=replace_with_strong_jwt_secret_at_least_32_chars_long

# ==============================================================================
# 4. การตั้งค่า LINE Official Account & LIFF SDK (apps/api & apps/liff)
# ==============================================================================
# LIFF Channel ID สำหรับตรวจสอบ ID Token ฝั่ง Backend แยกตามแบรนด์ไทวัสดุ (TWD) และ BnB Home (BNB)
LINE_LIFF_CHANNEL_ID_TWD=your_twd_liff_channel_id
LINE_LIFF_CHANNEL_ID_BNB=your_bnb_liff_channel_id

# รหัส LIFF ID สำหรับใช้เรียก liff.init() ในฝั่ง Frontend (apps/liff)
VITE_LIFF_ID=1234567890-AbCdEfGh

# URL ของ Backend API สำหรับให้ฝั่ง LIFF Frontend เรียกใช้งาน
VITE_API_BASE_URL=http://localhost:3000

# ==============================================================================
# 5. การเชื่อมต่อ API ภายนอกของ The 1 Passport (integration/the1)
# ==============================================================================
# เปิดโหมด Mock Server สำหรับ The 1 API คืนสมาชิกตัวอย่าง 3 คนและจำลอง Token หมดอายุ (true | false)
THE1_MOCK=true

# URL หลักของระบบ The 1 API (รอใส่ค่าจริงเมื่อยืนยัน Spec)
THE1_BASE_URL=https://api-mock.the1.co.th

# ข้อมูล Client ID และ Client Secret สำหรับเชื่อมต่อระบบ The 1
THE1_CLIENT_ID=your_the1_client_id
THE1_CLIENT_SECRET=your_the1_client_secret

# เวลา Timeout สูงสุดต่อการเรียก The 1 API 1 ครั้ง (หน่วยเป็นมิลลิวินาที, ค่าเริ่มต้น 5000)
THE1_TIMEOUT_MS=5000

# ==============================================================================
# 6. การเชื่อมต่อ API ยอดใช้จ่ายไทวัสดุ และการส่งออก Batch File (Spending & Batch)
# ==============================================================================
# เปิดโหมดจำลอง (Mock) สำหรับ API ดึงยอดใช้จ่ายรายลูกค้าของไทวัสดุ (true | false)
TWD_SPENDING_API_USE_MOCK=true

# URL หลักของ API ยอดใช้จ่ายไทวัสดุ (Get Spending)
TWD_SPENDING_API_BASE_URL=https://api-mock.thaiwatsadu.com

# API Key สำหรับเรียกข้อมูลยอดใช้จ่ายจากระบบไทวัสดุ
TWD_SPENDING_API_KEY=your_twd_spending_api_key

# โฟลเดอร์ปลายทางสำหรับส่งออกไฟล์ Batch กลุ่มเป้าหมายกลับไปยังไทวัสดุ
TWD_BATCH_EXPORT_DIR=./exports/batch
