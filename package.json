{
  "name": "line-connect-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ระบบ Line Connect สำหรับไทวัสดุ (TWD) และ BnB Home โดย IT-Division",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"apps/*/src/**/*.{ts,tsx}\"",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "jest --config apps/api/jest.config.cjs apps/api/src/modules/member/e2e-full-journey.spec.ts",
    "test:load": "k6 run tests/load/k6-auth-and-home.js",
    "deploy:rollback": "sh deploy/scripts/rollback.sh prod"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
